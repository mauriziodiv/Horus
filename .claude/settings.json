{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -ExecutionPolicy Bypass -File \".claude/hooks/build-check.ps1\"",
            "timeout": 60,
            "statusMessage": "Building..."
          }
        ]
      }
    ]
  }
}
